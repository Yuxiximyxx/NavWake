<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ 包可见性。选择框要判断「三个目标装没装」，看不见就查不到，
      查不到就会把它们从列表里过滤掉（真机踩过：只显示了 DSH Go）。
      两条保险都上：
      1) QUERY_ALL_PACKAGES —— 个人侧载应用，不受 Play 商店限制；
      2) 显式 <queries> —— 万一权限被拒，显式声明仍可见。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <!-- 被 hook 的系统进程 -->
        <package android:name="com.hihonor.magicvoice" />
        <package android:name="com.hihonor.brain" />
        <package android:name="com.android.systemui" />
        <package android:name="com.hihonor.systemui" />
    </queries>

    <application
        android:name=".NavWakeApp"
        android:label="@string/app_name"
        android:description="@string/app_subtitle"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.NavWake">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|fontScale|uiMode">
            <!-- 普通启动入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- LSPosed 模块列表点「设置」走这个 -->
            <intent-filter>
                <action android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 长按导航条后弹出的底部选择框。SystemUI 跨包拉起，必须 exported。 -->
        <activity
            android:name=".ChooserActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/chooser_title"
            android:theme="@style/Theme.NavWake.Chooser" />

        <!-- 旧式模块声明（现代声明在 META-INF/xposed/ 三件套里） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
    </application>

</manifest>
